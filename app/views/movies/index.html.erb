<!--  This file is app/views/movies/index.html.erb -->

<h1>Movies</h1>

<%= form_tag movies_path, method: :get, id: 'ratings_form', class: 'mb-3' do %>
  <%= hidden_field_tag :sort_by, @sort %>
  <%= hidden_field_tag :ratings_submitted, '1' %>
  <fieldset>
    <legend class="fs-6">Include ratings:</legend>
    <% @all_ratings.each do |rating| %>
      <span class="form-check form-check-inline">
        <%= check_box_tag "ratings[#{rating}]", '1', @selected_ratings.include?(rating), id: "ratings_#{rating}", class: 'form-check-input' %>
        <%= label_tag "ratings_#{rating}", rating, class: 'form-check-label' %>
      </span>
    <% end %>
    <%= submit_tag 'Refresh', id: 'ratings_submit', class: 'btn btn-primary btn-sm' %>
  </fieldset>
<% end %>

<table id="movies" class="table table-striped table-hover">
  <caption class="visually-hidden">Movies matching the selected ratings.</caption>
  <thead>
    <tr>
      <th scope="col" class="<%= 'hilite bg-info' if @sort == 'title' %>" aria-sort="<%= @sort == 'title' ? 'ascending' : 'none' %>">
        <%= link_to 'Movie Title', movies_path(sort_by: 'title', ratings: @selected_ratings.index_with { '1' }, ratings_submitted: '1'), id: 'title_header' %>
      </th>
      <th scope="col">Rating</th>
      <th scope="col" class="<%= 'hilite bg-info' if @sort == 'release_date' %>" aria-sort="<%= @sort == 'release_date' ? 'ascending' : 'none' %>">
        <%= link_to 'Release Date', movies_path(sort_by: 'release_date', ratings: @selected_ratings.index_with { '1' }, ratings_submitted: '1'), id: 'release_date_header' %>
      </th>
      <th scope="col">More Info</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <%= render 'movie_row', movie: movie %>
    <% end %>
  </tbody>
</table>

<%= link_to "New movie", new_movie_path, class: 'btn btn-primary' %>
